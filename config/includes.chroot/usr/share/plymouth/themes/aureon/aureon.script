# AUREON OS Plymouth Theme Script

# Load background and logo images
background = Image("background.png")
logo = Image("/usr/share/aureonos/assets/logo.png")
text_logo = Image("/usr/share/aureonos/assets/text-logo.png")

# Screen dimensions
screen_width = Window.GetWidth()
screen_height = Window.GetHeight()

# Background sprite
bg_sprite = Sprite(background)
bg_sprite.SetPosition(0, 0, -100)

# Logo sprite - centered
logo_width = logo.GetWidth()
logo_height = logo.GetHeight()
logo_x = (screen_width - logo_width) / 2
logo_y = (screen_height - logo_height) / 2 - 50
logo_sprite = Sprite(logo)
logo_sprite.SetPosition(logo_x, logo_y, 0)

# Text logo sprite - bottom centered
text_logo_width = text_logo.GetWidth()
text_logo_height = text_logo.GetHeight()
text_logo_x = (screen_width - text_logo_width) / 2
text_logo_y = (screen_height - text_logo_height) / 2 + 150
text_logo_sprite = Sprite(text_logo)
text_logo_sprite.SetPosition(text_logo_x, text_logo_y, 5)

# Progress bar
progress_box = Image("progress_box.png")
progress_bar = Image("progress_bar.png")
progress_box_sprite = Sprite(progress_box)
progress_bar_sprite = Sprite(progress_bar)

box_width = progress_box.GetWidth()
box_height = progress_box.GetHeight()
bar_width = progress_bar.GetWidth()
bar_height = progress_bar.GetHeight()

box_x = (screen_width - box_width) / 2
box_y = logo_y + logo_height + 60
bar_x = box_x + (box_width - bar_width) / 2
bar_y = box_y + (box_height - bar_height) / 2

progress_box_sprite.SetPosition(box_x, box_y, 10)
progress_bar_sprite.SetPosition(bar_x, bar_y, 20)

# Status message
status_font = Font("Inter", 16)
status_sprite = Sprite()
status_sprite.SetPosition((screen_width - 400) / 2, box_y + box_height + 20, 30)

# Animation variables
progress = 0.0
direction = 1

fun refresh_callback () {
    global progress, direction
    
    # Pulse animation
    progress = progress + direction * 0.02
    if (progress >= 1.0) {
        progress = 1.0
        direction = -1
    } else if (progress <= 0.0) {
        progress = 0.0
        direction = 1
    }
    
    # Update progress bar
    progress_bar_sprite.SetOpacity(progress)
    
    # Update status message
    status = Plymouth.GetMode()
    if (status == "boot") {
        status_sprite.SetText("Starting AUREON OS...")
    } else if (status == "shutdown") {
        status_sprite.SetText("Shutting down...")
    }
}

Plymouth.SetRefreshFunction(refresh_callback)

# Message display
fun display_message_callback (text) {
    status_sprite.SetText(text)
}

Plymouth.SetMessageFunction(display_message_callback)

# Progress display
fun display_progress_callback (duration, progress) {
    # Progress bar fills based on actual progress
    progress_bar_sprite.SetOpacity(progress)
}

Plymouth.SetProgressFunction(display_progress_callback)

# Boot progress
fun progress_callback (duration, progress) {
    progress_bar_sprite.SetOpacity(progress)
}

Plymouth.SetBootProgressFunction(progress_callback)