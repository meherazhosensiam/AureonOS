#!/bin/sh

set -eu

CHROOT=$(mount | awk '/proc.*calamares/ {print $3; exit}' | sed 's#/proc##')
KNOWN_MEDIUM_PATHS="/run/live/medium /run/initramfs/live"
RELEASE="trixie"
SOURCE_FILE="$CHROOT/etc/apt/sources.list.d/debian-live-media.list"

MEDIUM_PATH=""

for path in $KNOWN_MEDIUM_PATHS; do
    if mount | grep -q " $path "; then
        MEDIUM_PATH="$path"
        break
    fi
done

cleanup() {
    rm -f "$SOURCE_FILE"

    if [ -n "${MEDIUM_PATH:-}" ] && mountpoint -q "$CHROOT/$MEDIUM_PATH"; then
        umount "$CHROOT/$MEDIUM_PATH" || true
    fi

    rm -rf "$CHROOT/run/live/medium" 2>/dev/null || true
    rm -rf "$CHROOT/run/live" 2>/dev/null || true
}

if [ "${1:-}" = "-u" ]; then
    cleanup

    if [ -d "$CHROOT/etc/apt" ]; then
        chroot "$CHROOT" apt-get update || true
    fi

    exit 0
fi

# Do not allow duplicate repositories.
rm -f "$SOURCE_FILE"
rm -f "$CHROOT/etc/apt/sources.list.d/base.list"

if [ -z "$MEDIUM_PATH" ]; then
    echo "ERROR: Calamares live medium was not found."
    exit 1
fi

mkdir -p "$CHROOT/$MEDIUM_PATH"

mount --bind "$MEDIUM_PATH" "$CHROOT/$MEDIUM_PATH"

# Temporary repository used only while installing.
echo "deb [trusted=yes] file:$MEDIUM_PATH $RELEASE main" > "$SOURCE_FILE"

chroot "$CHROOT" apt-get update

exit 0
