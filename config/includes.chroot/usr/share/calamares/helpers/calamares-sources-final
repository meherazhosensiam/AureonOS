#!/bin/sh

set -eu

CHROOT=$(mount | awk '/proc.*calamares/ {print $3; exit}' | sed 's#/proc##')
RELEASE="trixie"

cat > "$CHROOT/etc/apt/sources.list" <<EOL
# AUREON OS - Debian ${RELEASE} repositories

deb http://deb.debian.org/debian ${RELEASE} main contrib non-free non-free-firmware
deb http://deb.debian.org/debian ${RELEASE}-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security ${RELEASE}-security main contrib non-free non-free-firmware
EOL

# Remove temporary/live-media repositories
rm -f "$CHROOT/etc/apt/sources.list.d/debian-live-media.list"
rm -f "$CHROOT/etc/apt/sources.list.d/base.list"

# Remove any accidental duplicate live-media entries
sed -i '/file:\/run\/live\/medium/d' "$CHROOT/etc/apt/sources.list" 2>/dev/null || true
sed -i '/file:\/run\/initramfs\/live/d' "$CHROOT/etc/apt/sources.list" 2>/dev/null || true

exit 0
