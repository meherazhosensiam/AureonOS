# @PROJECT_NAME@ - ArcMenu Branding Override
# =====================================
# Configures ArcMenu to use the @PROJECT_NAME@ logo as the menu button icon.
# This supplements the main ArcMenu configuration in 01-aureon-defaults.
#
# After modifying this file, run: dconf update

[org/gnome/shell/extensions/arc-menu]
menu-button-icon='Custom'
menu-button-custom-icon='/usr/share/@PROJECT_ID@/assets/logo.png'