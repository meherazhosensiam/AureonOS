#!/bin/sh
set -e

# ============================================================
# AUREON OS - Trust installer desktop entry
# ============================================================
# Marks the installer .desktop file as trusted so GNOME allows
# launching it without prompting the user to "Allow Launching".
# This works for both live and installed systems.
# ============================================================

# Load project config for PROJECT_ID
if [ -f "/etc/aureon/project.conf" ]; then
    . /etc/aureon/project.conf
else
    PROJECT_ID="aureonos"
fi

DESKTOP_FILE="/usr/share/applications/install-${PROJECT_ID}.desktop"

if [ -f "$DESKTOP_FILE" ]; then
    # Mark as trusted for all users by setting the metadata
    # This requires glib2.0-bin (gio) to be available
    if command -v gio >/dev/null 2>&1; then
        gio set "$DESKTOP_FILE" "metadata::trusted" true 2>/dev/null || true
        echo "[ OK ] Installer desktop entry marked as trusted"
    fi
fi

exit 0
