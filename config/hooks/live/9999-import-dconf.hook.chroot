#!/bin/bash
set -e

# 1. Ensure Machine-ID is present
if [ ! -f /etc/machine-id ]; then
    dbus-uuidgen > /etc/machine-id
fi

# 2. Ensure the dconf directory exists
mkdir -p /etc/dconf/db/local.d

# 3. Load the settings file
SOURCE_FILE="/etc/dconf/db/local.d/00-aureon-extensions"
if [ -f "$SOURCE_FILE" ]; then
    dconf load /org/gnome/shell/extensions/ < "$SOURCE_FILE"
fi

# 4. Update the dconf system databases
dconf update
