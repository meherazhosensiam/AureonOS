#!/bin/bash
# Tuning the kernel for low resource consumption and flexibility

# 1. Optimize Virtual Memory Management (Less disk swapping)
echo "vm.swappiness = 10" >> /etc/sysctl.d/99-performance.conf
echo "vm.vfs_cache_pressure = 50" >> /etc/sysctl.d/99-performance.conf

# 2. Optimize Network Stack for speed
echo "net.core.rmem_max = 16777216" >> /etc/sysctl.d/99-performance.conf
echo "net.core.wmem_max = 16777216" >> /etc/sysctl.d/99-performance.conf

# 3. Disable unnecessary kernel debugging to free up RAM
echo "kernel.printk = 3 3 3 3" >> /etc/sysctl.d/99-performance.conf

# 4. Enable KSM (Kernel Samepage Merging) to save RAM by merging duplicate memory pages
echo 1 > /sys/kernel/mm/ksm/run
