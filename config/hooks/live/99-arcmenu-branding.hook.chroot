#!/bin/bash

# Ensure the config directory for dconf exists
mkdir -p /etc/dconf/db/local.d/

# Set the Arc Menu icon programmatically
cat <<EOF > /etc/dconf/db/local.d/10-arcmenu-branding
[org/gnome/shell/extensions/arc-menu]
menu-button-icon='Custom'
menu-button-custom-icon='/usr/share/aureonos/assets/logo.png'
EOF

# Update the dconf database
dconf update
