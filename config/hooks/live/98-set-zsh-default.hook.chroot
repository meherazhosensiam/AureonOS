#!/bin/sh
set -eu

ZSH="/bin/zsh"

# Ensure Zsh exists
if [ ! -x "$ZSH" ]; then
    echo "Error: $ZSH not found."
    exit 1
fi

# Ensure Zsh is listed as a valid login shell
if ! grep -qxF "$ZSH" /etc/shells; then
    echo "$ZSH" >> /etc/shells
fi

# Set the default shell for adduser (used by Calamares fallbacks
# and any future user creation on the installed system).
if [ -f /etc/adduser.conf ]; then
    if grep -q '^DSHELL=' /etc/adduser.conf; then
        sed -i "s|^DSHELL=.*|DSHELL=$ZSH|" /etc/adduser.conf
    else
        echo "DSHELL=$ZSH" >> /etc/adduser.conf
    fi
fi

# Set the default shell for useradd
if [ -f /etc/default/useradd ]; then
    if grep -q '^SHELL=' /etc/default/useradd; then
        sed -i "s|^SHELL=.*|SHELL=$ZSH|" /etc/default/useradd
    else
        echo "SHELL=$ZSH" >> /etc/default/useradd
    fi
fi

echo "Default shell configured as $ZSH."
