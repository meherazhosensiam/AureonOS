#!/bin/bash
set -e

# ============================================================
# AUREON OS - Install Fluent GTK/Icon/Cursor Themes
# ============================================================
# This hook downloads and installs the Fluent theme suite from
# vinceliuice's GitHub repositories. The themes provide the
# visual identity for AUREON OS (dark/light variants, red accent).
#
# EXECUTION ORDER: Runs during LIVE hook stage (after normal hooks).
# This is IMPORTANT because:
# 1. Normal hooks (including 99-set-plymouth-theme) run first
# 2. This hook installs the GTK/Icon/Cursor themes
# 3. 9999-aureon-compile-dconf.hook.chroot runs LAST and compiles
#    the dconf database AFTER themes are installed
#
# The dconf settings in 01-aureon-defaults reference:
#   gtk-theme='Fluent-red-Dark'
#   icon-theme='Fluent-red'
#   cursor-theme='Fluent-cursors'
# These must exist before dconf compilation, otherwise the settings
# would reference non-existent themes.
#
# DEPENDENCIES: git, wget, curl, unzip, sassc, libglib2.0-dev-bin
# (installed at start of hook)
#
# CLEANUP: Removes downloaded source directories after installation
# to minimize image size.

export DEBIAN_FRONTEND=noninteractive

apt-get update

# Dependencies for theme compilation
apt-get install -y \
    git \
    wget \
    curl \
    unzip \
    sassc \
    libglib2.0-dev-bin \
    gnome-shell-extensions

cd /tmp

########################################
# Fluent GTK Theme
########################################
# Provides: Fluent-red-Dark, Fluent-red-Light (and other colors)
# Installed to: /usr/share/themes/
git clone --depth=1 https://github.com/vinceliuice/Fluent-gtk-theme.git

cd Fluent-gtk-theme

# Install ONLY red variants (AUREON brand color)
# Dark variant (primary for AUREON)
./install.sh -t red -c dark -s standard --tweaks blur --libadwaita

# Light variant (for light mode support)
./install.sh -t red -c light -s standard --tweaks blur --libadwaita

cd ..

########################################
# Fluent Icon Theme
########################################
# Provides: Fluent-red (and other colors)
# Installed to: /usr/share/icons/
git clone --depth=1 https://github.com/vinceliuice/Fluent-icon-theme.git

cd Fluent-icon-theme

# Install ONLY red variants
./install.sh red

cd ..

########################################
# Fluent Cursor Theme
########################################
# Provides: Fluent-cursors, Fluent-dark-cursors
# Installed to: /usr/share/icons/
cd Fluent-icon-theme
cd cursors
./install.sh
cd ..
cd ..

########################################
# Verification
########################################
# Verify critical theme directories exist before dconf compilation
echo "==> Verifying theme installation..."
for theme in \
    "/usr/share/themes/Fluent-red-Dark" \
    "/usr/share/themes/Fluent-red-Light" \
    "/usr/share/icons/Fluent-red" \
    "/usr/share/icons/Fluent-cursors"; do
    if [ ! -d "$theme" ]; then
        echo "ERROR: Required theme directory missing: $theme"
        exit 1
    fi
    echo "  OK: $theme"
done

########################################
# Cleanup
########################################
# Remove build directories to save space
rm -rf \
    Fluent-gtk-theme \
    Fluent-icon-theme \
    fluent-cursor

# Remove any non-red theme variants that may have been installed
# Keep only Fluent-red-* themes
for theme_dir in /usr/share/themes/Fluent-*; do
    case "$(basename "$theme_dir")" in
        Fluent-red-Dark|Fluent-red-Light)
            echo "  Keeping: $(basename "$theme_dir")"
            ;;
        *)
            echo "  Removing unused theme: $(basename "$theme_dir")"
            rm -rf "$theme_dir"
            ;;
    esac
done

# Keep only Fluent-red* icon themes
for icon_dir in /usr/share/icons/Fluent-*; do
    case "$(basename "$icon_dir")" in
        Fluent-red|Fluent-red-dark|Fluent-red-light)
            echo "  Keeping: $(basename "$icon_dir")"
            ;;
        *)
            echo "  Removing unused icon theme: $(basename "$icon_dir")"
            rm -rf "$icon_dir"
            ;;
    esac
done

apt-get clean
apt-get autoremove -y
rm -rf /var/lib/apt/lists/*
rm -rf /var/cache/apt/archives/*.deb
