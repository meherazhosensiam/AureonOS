#!/bin/bash
set -e

# Change distribution name shown by GDM
mkdir -p /etc

cat > /etc/os-release <<'EOF'
PRETTY_NAME="AUREON OS"
NAME="AUREON OS"
VERSION="1.0"
VERSION_ID="1.0"
ID=aureon
ID_LIKE=debian
HOME_URL="https://aureon.local"
SUPPORT_URL="https://aureon.local"
BUG_REPORT_URL="https://aureon.local"
EOF

# Keep lsb-release consistent
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=AUREON
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=aureon
DISTRIB_DESCRIPTION="AUREON OS 1.0"
EOF
