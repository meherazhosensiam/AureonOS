
set -e

#!/bin/sh
set -e

# Remove GNOME wallpapers
rm -rf /usr/share/backgrounds/gnome

# Remove default profile avatars
rm -rf /usr/share/pixmaps/faces/*

# Remove Debian branding images
rm -f /usr/share/pixmaps/debian-logo.png
rm -f /usr/share/pixmaps/debian-security.png
rm -f /usr/share/pixmaps/install-debian.png

echo "Removing Debian installer launcher..."

rm -f /usr/share/applications/install-debian.desktop
rm -f /usr/share/pixmaps/install-debian.png

echo "Debian installer removed."

rm -f /usr/share/desktop-base/debian-homepage.desktop
rm -f /usr/share/desktop-base/debian-reference.desktop
rm -f /usr/share/desktop-base/debian-security.desktop

rm -rf /usr/share/desktop-base/debian-logos

echo "Debian desktop branding removed"

