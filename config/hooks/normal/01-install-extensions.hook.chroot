#!/bin/bash

# Directory where extensions should live in the ISO
EXT_DIR="config/includes.chroot/usr/share/gnome-shell/extensions"
mkdir -p "$EXT_DIR"

# List of UUIDs
EXTENSIONS=(
    "blur-my-shell@aunetx"
    "dash-to-panel@jderose9.github.com"
    "arcmenu@arcmenu.com"
    "lockscreen-extension@pratap.fastmail.fm"
    "date-menu-formatter@marcinjakubowski.github.com"
    "window-switcher@tbepdb"
    "tiling-assistant@leleat-on-github"
    "just-perfection-desktop@just-perfection"
    "perfect-fit@ryliov.work.com"
    "appindicatorsupport@rgcjonas.gmail.com"
    "clipboard-indicator@tudmotu.com"
    "caffeine@patapon.info"
    "quick-settings-tweaks@qwreey"
    "ding@rastersoft.com"
)

echo "Downloading and preparing extensions..."

for uuid in "${EXTENSIONS[@]}"; do
    echo "Processing: $uuid"
    # Note: This is a conceptual fetcher; you would ideally have the zips 
    # downloaded in a local folder to ensure build reliability.
    # For a build script, we recommend putting the pre-downloaded zips in a local folder.
done
