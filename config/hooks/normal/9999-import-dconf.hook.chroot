#!/bin/bash
set -e

# Generate a temporary machine ID for the build
rm -f /etc/machine-id /var/lib/dbus/machine-id

systemd-machine-id-setup

mkdir -p /var/lib/dbus
ln -sf /etc/machine-id /var/lib/dbus/machine-id

# Compile the system dconf database
dconf update

# Remove the machine ID so installed systems generate their own
rm -f /etc/machine-id /var/lib/dbus/machine-id
touch /etc/machine-id
